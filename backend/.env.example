# Database. Default is local SQLite. Postgres: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./wedding.db
# The owner admin is created at startup from OWNER_EMAIL (owner@localhost when unset). Other admins are added in the panel.
OWNER_EMAIL=
OWNER_NAME=
# Login codes are emailed through Resend. Without a key no code is created, unless OTP_DEBUG=1 (local use only:
# the code is printed to the server log instead of being emailed).
RESEND_API_KEY=
EMAIL_FROM=Atif & Nargis <wedding@fullstackcity.in>
OTP_DEBUG=
# Optional password fallback, logs in as the owner. Production: bcrypt hash (see README). Local only: plain ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
# If unset, a random secret is generated at startup (tokens die on restart).
JWT_SECRET=
JWT_EXPIRE_MINUTES=43200
ALLOWED_ORIGINS=http://localhost:5173
